{
  "name": "wegic-vite-react",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "concurrently -k -n web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "tsc --noEmit -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "lint": "eslint . --ext ts,tsx --quiet && postcss src/index.css -o /dev/null",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.server.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@supabase/supabase-js": "^2.49.8",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.552.0",
    "only-allow": "^1.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.9.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.181.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.1",
    "supertest": "^7.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.0",
    "vite-plugin-client-error-logger": "^0.1.4",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-react-fiber-source": "^0.1.3",
    "vitest": "^5.0.2"
  }
}
